<?xml version="1.0" encoding="UTF-8"?>
<!--
  Two URLs, both on the www host so they match the canonicals exactly.
  A sitemap listing a host you redirect away from is ignored.

  Update <lastmod> when the page content meaningfully changes. Google
  treats a date that moves on every deploy, with no real change behind
  it, as noise and stops trusting the field.
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>https://www.wearelacuna.com/</loc>
    <lastmod>2026-10-20</lastmod>
    <changefreq>monthly</changefreq>
    <priority>1.0</priority>
  </url>
</urlset>
